# --- API ---
PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://logger:logger@localhost:5432/logger
SESSION_SECRET=change-me-to-a-long-random-string
# Public URL of the site (web + API behind one origin in production)
APP_ORIGIN=http://localhost:8080
# Secure cookies need HTTPS. Keep false for local testing on http://localhost; set true on the droplet behind TLS.
COOKIE_SECURE=false

# --- Google OAuth (Google Cloud Console > APIs & Services > Credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local Docker: http://localhost:8080/auth/google/callback   Dev servers: http://localhost:5173/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback

# Only these two Google accounts can sign in. Format: email:account,email:account
ALLOWED_USERS=santosh.krishna0909@gmail.com:anilsub02,mailanilkumar@gmail.com:anilsub01

# --- IBKR Flex Web Service ---
FLEX_TOKEN=
FLEX_TRADE_CONFIRM_QUERY_ID=
FLEX_ACTIVITY_QUERY_ID=
FLEX_BASE_URL=https://ndcdyn.interactivebrokers.com/AccountManagement/FlexWebService

# --- Docker Compose only ---
POSTGRES_PASSWORD=change-me
