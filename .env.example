# --- API ---
PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://tradelog:tradelog@localhost:5432/tradelog
SESSION_SECRET=change-me-to-a-long-random-string
# Public URL of the site (web + API behind one origin in production)
APP_ORIGIN=http://localhost:5173

# --- Google OAuth (Google Cloud Console > APIs & Services > Credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/auth/google/callback

# Only these two Google accounts can sign in. Format: email:account,email:account
ALLOWED_USERS=santosh@example.com:anilsub02,anil@example.com:anilsub01

# --- IBKR Flex Web Service ---
FLEX_TOKEN=
FLEX_TRADE_CONFIRM_QUERY_ID=
FLEX_ACTIVITY_QUERY_ID=
FLEX_BASE_URL=https://ndcdyn.interactivebrokers.com/AccountManagement/FlexWebService

# --- Docker Compose only ---
POSTGRES_PASSWORD=change-me
