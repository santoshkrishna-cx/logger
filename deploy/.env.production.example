# --- Secrets: generate fresh ones for production (openssl rand -base64 36) ---
POSTGRES_PASSWORD=
SESSION_SECRET=

# --- Google OAuth (add the https origin and callback to the same OAuth client) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://tradelog.example.com/auth/google/callback
ALLOWED_USERS=santosh.krishna0909@gmail.com:anilsub02,mailanilkumar@gmail.com:anilsub01

# --- IBKR Flex (token locked to this droplet's public IPv4) ---
FLEX_TOKEN=
FLEX_TRADE_CONFIRM_QUERY_ID=
FLEX_ACTIVITY_QUERY_ID=
FLEX_BASE_URL=https://ndcdyn.interactivebrokers.com/AccountManagement/FlexWebService
