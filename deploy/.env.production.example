# Copy to /opt/tradelog/.env on the droplet and fill in. Never commit the real file.

# --- Site ---
DOMAIN=tradelog.example.com
ACME_EMAIL=santosh.krishna0909@gmail.com
APP_ORIGIN=https://tradelog.example.com
COOKIE_SECURE=true
PORT=4000

# --- Images (the Deploy workflow sets TAG and IMAGE_PREFIX on each run) ---
