# Copy to /opt/logger/.env on the droplet and fill in. Never commit the real file.

# --- Site ---
DOMAIN=logger.example.com
ACME_EMAIL=santosh.krishna0909@gmail.com
APP_ORIGIN=https://logger.example.com
COOKIE_SECURE=true
PORT=4000

# --- Images (the Deploy workflow sets TAG and IMAGE_PREFIX on each run) ---
IMAGE_PREFIX=ghcr.io/santoshkrishna-cx

# --- Secrets: generate fresh ones for production (openssl rand -base64 36) ---
POSTGRES_PASSWORD=
SESSION_SECRET=

# --- Google OAuth (add the https origin and callback to the same OAuth client) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://logger.example.com/auth/google/callback
ALLOWED_USERS=santosh.krishna0909@gmail.com:anilsub02,mailanilkumar@gmail.com:anilsub01

# --- IBKR Flex (token locked to this droplet's public IPv4) ---
FLEX_TOKEN=
FLEX_TRADE_CONFIRM_QUERY_ID=
FLEX_ACTIVITY_QUERY_ID=
